# Copy to .env in the repository root:  cp .env.sample .env
# Nothing here is a real credential.

# --- Django ---------------------------------------------------------------
# Required when DJANGO_DEBUG is off. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# --- Identity provider ----------------------------------------------------
# cognito | memory   (memory needs no AWS account and is intended for local work)
AUTH_PROVIDER=memory

COGNITO_REGION=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Omit both AWS keys in production and let the instance role supply credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Behaviour ------------------------------------------------------------
PROFILE_CACHE_TTL=60
GRAPHIQL_ENABLED=1
SEED_DEMO_ON_START=0
ENABLE_DJANGO_ADMIN=0
CORS_ALLOW_ALL_ORIGINS=0
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Optional AI ----------------------------------------------------------
# rules | claude   (claude silently falls back to rules with no key present)
AI_GOAL_PARSER=rules
AI_MODEL=claude-opus-5
ANTHROPIC_API_KEY=
